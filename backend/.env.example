DATABASE_URL=postgresql+asyncpg://suuqii:suuqii@localhost:5432/suuqii
DATABASE_URL_SYNC=postgresql://suuqii:suuqii@localhost:5432/suuqii
JWT_SECRET=change-me-run-python-c-import-secrets-print-secrets-token-urlsafe-48
JWT_SECRET_PREVIOUS=
JWT_ACCESS_TTL_MIN=60
JWT_REFRESH_TTL_DAYS=30
JWT_OWNER_CHALLENGE_TTL_MIN=5
ALLOWED_ORIGINS=*
FCM_PROJECT_ID=
FCM_PRIVATE_KEY=
SENTRY_DSN=
LOG_LEVEL=INFO
# Shared rate-limit storage (e.g. redis://host:6379/0). Empty = in-memory,
# which is per-instance only — each serverless instance counts separately.
RATE_LIMIT_REDIS_URL=
# Oldest allowed mobile app version (semver x.y.z) on /v1; clients sending a
# lower/missing X-App-Version header get 426 app_update_required. Empty = off.
MIN_APP_VERSION=
DEFAULT_LOCALE=en
TIMEZONE=Africa/Addis_Ababa
